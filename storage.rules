rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if request.auth != null && request.auth.uid == userId;
// allow read: if request.auth != null;

service firebase.storage {
  match /b/{bucket}/o {
    
    // Kullanıcıların kendi kimlik kartlarını yüklemesine izin ver
    // Sadece PDF veya resim (image/*) dosyalarına izin ver
    // Dosya boyutu 5MB ile sınırlı
    match /id_cards/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Kullanıcı profil fotoğrafları
    match /profile_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Görev görselleri
    match /task_images/{taskId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Fonksiyonlar
    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
