        "iyzipay": "^2.0.55",
        "markdown-it": "^14.1.0",
        "nodemailer": "^6.9.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.17",
        "@types/node": "^18.0.0",
        "@types/nodemailer": "^6.4.7",
        "@typescript-eslint/eslint-plugin": "^5.12.0",
        "@typescript-eslint/parser": "^5.12.0",
        "eslint": "^8.9.0",
        "eslint-config-google": "^0.14.0",
        "eslint-plugin-import": "^2.25.4",
        "typescript": "^4.9.0"
