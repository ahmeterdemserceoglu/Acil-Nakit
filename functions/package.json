    "engines": {
        "node": "20"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@types/markdown-it": "^14.1.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "firebase-admin": "^13.6.0",
