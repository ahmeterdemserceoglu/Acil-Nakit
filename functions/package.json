{
    "name": "collabo-functions",
    "description": "Collabo Cloud Functions - Payment & Escrow System",
    "scripts": {
        "lint": "eslint --ext .js,.ts .",
        "build": "tsc",
        "serve": "npm run build && firebase emulators:start --only functions",
