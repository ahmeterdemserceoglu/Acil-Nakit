<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>
    <include domain="file" path="."/>

    <exclude domain="sharedpref" path="appid.xml"/>
    <exclude domain="database" path="appid.xml"/>
    <exclude domain="file" path="appid.xml"/>

    <exclude domain="sharedpref" path="crashlytics"/>
    <exclude domain="database" path="crashlytics"/>
    <exclude domain="file" path="crashlytics"/>

    <exclude domain="sharedpref" path="perf"/>
    <exclude domain="database" path="perf"/>
    <exclude domain="file" path="perf"/>
</full-backup-content>