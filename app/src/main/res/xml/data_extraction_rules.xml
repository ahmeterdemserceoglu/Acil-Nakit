<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <exclude domain="sharedpref" path="appid.xml"/>
        <exclude domain="database" path="appid.xml"/>
        <exclude domain="file" path="appid.xml"/>

        <exclude domain="sharedpref" path="crashlytics"/>
        <exclude domain="database" path="crashlytics"/>
        <exclude domain="file" path="crashlytics"/>

        <exclude domain="sharedpref" path="perf"/>
        <exclude domain="database" path="perf"/>
        <exclude domain="file" path="perf"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <exclude domain="sharedpref" path="appid.xml"/>
        <exclude domain="database" path="appid.xml"/>
        <exclude domain="file" path="appid.xml"/>

        <exclude domain="sharedpref" path="crashlytics"/>
        <exclude domain="database" path="crashlytics"/>
        <exclude domain="file" path="crashlytics"/>

        <exclude domain="sharedpref" path="perf"/>
        <exclude domain="database" path="perf"/>
        <exclude domain="file" path="perf"/>
    </device-transfer>
</data-extraction-rules>